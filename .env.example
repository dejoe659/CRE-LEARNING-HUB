# Copy to .env.local and fill in. NEVER commit real keys.

# --- Supabase (public values are safe in the browser; RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (server only) ---
PAYSTACK_SECRET_KEY=

# --- AI tutor (server only) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Misc ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
